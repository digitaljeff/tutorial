# Copy to .env and fill in. Any key left empty keeps that modality on its mock provider.

# --- LLM (Screenwriter/Showrunner agents) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- fal.ai (images + video; one account covers Seedream/Seedance/Kling/Veo) ---
FAL_KEY=
# Model ids are configurable because they reprice/rename often — verify on fal.ai
FAL_IMAGE_MODEL=fal-ai/bytedance/seedream/v4.5/text-to-image
FAL_VIDEO_MODEL=fal-ai/bytedance/seedance/v1.5/pro/image-to-video

# --- ElevenLabs (dialogue voices, later SFX + music) ---
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Fallback voice used when a character has no voice_id yet (Rachel public preset)
ELEVENLABS_DEFAULT_VOICE=21m00Tcm4TlvDq8ikWAM
